{
  "name": "noxy-bots",
  "version": "0.0.0",
  "description": "Cute, expressive bots for your UI",
  "keywords": [
    "bot",
    "mascot",
    "avatar",
    "animation",
    "svg",
    "web-component",
    "react",
    "character"
  ],
  "homepage": "https://noxybots.com",
  "bugs": "https://github.com/sinetthapa/noxy-bots/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sinetthapa/noxy-bots.git"
  },
  "license": "(MIT AND CC-BY-4.0)",
  "author": "Sinet Thapa",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-ART"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./element": "./dist/element.js",
    "./react": "./dist/react.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/check-package.js",
    "build:lab": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p studio && astro sync --root site && tsc -p site",
    "import-art": "node scripts/import-art.ts",
    "examples": "npm run build && tsc -p examples && vite --config examples/vite.config.ts",
    "perf": "npm run build && node scripts/perf.js",
    "size": "npm run build && node scripts/size.js",
    "studio": "vite --config studio/vite.config.ts",
    "site": "cd site && astro dev",
    "build:site": "astro build --root site",
    "deploy": "wrangler deploy",
    "release": "npm run build && changeset publish",
    "version-packages": "changeset version && npm install --package-lock-only"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@changesets/cli": "^3.0.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@lottiefiles/dotlottie-web": "^0.80.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tweakpane/core": "^2.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "^20.14.5",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.52.0",
    "mediabunny": "^1.61.3",
    "posthog-js": "^1.438.7",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tweakpane": "^4.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "sideEffects": [
    "./dist/element.js"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
