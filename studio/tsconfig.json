{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "noxy-bots": ["../src/index.ts"],
      "noxy-bots/element": ["../src/element.ts"],
      "noxy-bots/react": ["../src/react.ts"],
      "noxy-src/*": ["../src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
