---
// Every docs page (M5 spec §6.1): /docs is Getting started (index.mdx), the rest /docs/<file name>.
import { getCollection, render } from 'astro:content';
import CodeBlock from '../../components/CodeBlock.astro';
import Demo from '../../components/Demo.astro';
import StateChips from '../../components/StateChips.astro';
import Table from '../../components/Table.astro';
import { toMarkdown } from '../../docs.ts';
import Docs from '../../layouts/Docs.astro';

export async function getStaticPaths() {
  return (await getCollection('docs')).map((entry) => ({ params: { slug: entry.id === 'index' ? undefined : entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<Docs page={{ id: entry.id, ...entry.data }} headings={headings} md={toMarkdown(entry.data, entry.body ?? '')}>
  <Content components={{ Demo, StateChips, pre: CodeBlock, table: Table }} />
</Docs>
