// The site Worker (M5 spec §9.1): static assets from dist-site/, the script only for the PostHog proxy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noxy",
  "main": "site/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false, // no workers.dev URL
  "routes": [{ "pattern": "noxybots.com", "custom_domain": true }], // launch (M5 spec §9.1); www redirects by a zone rule
  "preview_urls": false, // Workers Builds builds main only since launch (audit run-2, lead 2)
  "previews": {}, // Previews don't inherit production settings; top-level assets are enough
  "assets": {
    "directory": "dist-site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/ingest/*"]
  }
}
